@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div id="personal-projects" class="container fade-in mt-5 pt-5">
    <h2 class="section-title">@L["PersonalProject_Title"]</h2>

    <div class="d-flex flex-wrap justify-content-around">
        @foreach (var proj in projects)
        {
            <div class="col-md-4 mb-4 fade-in">
                <div class="card project-card shadow-sm p-1">
                    <img src="@proj.Image" class="card-img-top" alt=@L[proj.TitleKey] />
                    <div class="card-body">
                        <h5 class="card-title">@L[proj.TitleKey]</h5>
                        <p class="card-text">@L[proj.DescriptionKey]</p>
                        <div class="project-button justify-content-center">
                            <a href="@proj.Link" target="_blank" class="btn btn-portfolio">@L["PersonalProject_ViewButton"]</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    record Project(string TitleKey, string DescriptionKey, string Image, string Link);

    List<Project> projects = new()
    {
        new Project(
            "PersonalProject_GoldenBarbers_Title",
            "PersonalProject_GoldenBarbers_Desc",
            "images/golden_barbers_screenshot1.png",
            "https://golden-barbers-bmfqbabta6haa2fv.westeurope-01.azurewebsites.net/"),
        new Project(
            "PersonalProject_PortfolioSite_Title",
            "PersonalProject_PortfolioSite_Desc",
            "images/portfolio_screenshot.png",
            "https://github.com/juusosav/coding-portfolio"),
        new Project(
            "PersonalProject_HabitTracker_Title",
            "PersonalProject_HabitTracker_Desc",
            "images/habit_tracker1.png",
            "https://habittracker-gzcqecg9g7gzcgee.canadacentral-01.azurewebsites.net/")
    };
}
